# =============================================================================
#  AROVIA Platform — Environment Variables Template
#  Copy this to .env and fill in your secrets. Never commit .env to git.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=AROVIA

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arovia_db
POSTGRES_USER=arovia_user
POSTGRES_PASSWORD=arovia_secret
DATABASE_URL=postgresql://arovia_user:arovia_secret@localhost:5432/arovia_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=arovia_redis_secret
REDIS_URL=redis://:arovia_redis_secret@localhost:6379

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=arovia-platform
KAFKA_GROUP_ID=arovia-consumers

# --- JWT Auth ---
JWT_SECRET=change_me_in_production_use_256bit_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Services Ports ---
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
PITCH_SERVICE_PORT=4002
LIVE_SESSION_PORT=4003
LEDGER_SERVICE_PORT=4004
AI_AGENT_37_PORT=8000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4003
NEXT_PUBLIC_APP_NAME=AROVIA

# --- AI Agent 37 ---
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
AGENT_MODEL=gpt-4o

# --- pgAdmin (dev tools) ---
PGADMIN_EMAIL=admin@arovia.io
PGADMIN_PASSWORD=arovia_admin
